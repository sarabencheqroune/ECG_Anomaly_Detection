# ECG Anomaly Detection Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# Data Configuration
# ============================================
DATA_DIR=./data
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed
CACHE_DIR=./data/cache

# ============================================
# Model Configuration
# ============================================
MODEL_TYPE=hybrid
MODEL_DIR=./models
CHECKPOINT_DIR=./checkpoints
INPUT_DIM=187
NUM_CLASSES=5
LATENT_DIM=32
DROPOUT=0.2

# ============================================
# Training Configuration
# ============================================
EPOCHS=100
BATCH_SIZE=64
LEARNING_RATE=0.001
OPTIMIZER=adamw
WEIGHT_DECAY=0.0001
SCHEDULER=cosine
EARLY_STOPPING_PATIENCE=20
MIXED_PRECISION=true
GRADIENT_CLIP=1.0

# ============================================
# Inference Configuration
# ============================================
CONFIDENCE_THRESHOLD=0.7
ANOMALY_THRESHOLD=0.5
INFERENCE_BATCH_SIZE=32
DEVICE=auto
USE_AMP=true

# ============================================
# HITL Configuration
# ============================================
HITL_ENABLED=true
HITL_CONFIDENCE_THRESHOLD=0.7
HITL_MAX_QUEUE_SIZE=1000
HITL_CRITICAL_TIMEOUT=300
HITL_HIGH_TIMEOUT=3600
HITL_MEDIUM_TIMEOUT=86400
HITL_LOW_TIMEOUT=604800
HITL_USE_REDIS=false
REDIS_URL=redis://localhost:6379/0

# ============================================
# Dashboard Configuration
# ============================================
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=5000
DASHBOARD_DEBUG=false
SECRET_KEY=your-secret-key-here-change-in-production

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=INFO
LOG_DIR=./logs
TENSORBOARD=true
METRICS_LOGGER=true

# ============================================
# API Configuration (for production)
# ============================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_TIMEOUT=30
CORS_ORIGINS=*

# ============================================
# Database (optional)
# ============================================
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=ecg_monitoring
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres

# ============================================
# Monitoring (optional)
# ============================================
# PROMETHEUS_ENABLED=false
# PROMETHEUS_PORT=9090
# GRAFANA_ENABLED=false
# GRAFANA_PORT=3000

# ============================================
# Email Alerts (optional)
# ============================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=alerts@example.com
# SMTP_PASSWORD=your-password
# ALERT_RECIPIENTS=admin@example.com,oncall@example.com

# ============================================
# Slack Alerts (optional)
# ============================================
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
# SLACK_CHANNEL=#ecg-alerts

# ============================================
# Reproducibility
# ============================================
RANDOM_SEED=42
DETERMINISTIC=true
CUDA_DETERMINISTIC=true